# Copy to .env.local and fill in. Share real values privately, never commit them.
# Add every new variable here immediately (empty value).

ANTHROPIC_API_KEY=
# default claude-sonnet-5-5
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# brain scoring model, default gpt-5.5
OPENAI_MODEL=
# brain extraction, filter, same-person checks, web search; default gpt-5.4-mini
OPENAI_MODEL_FAST=
# optional: if set, /api/brain/* require header x-brain-key with this value
BRAIN_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Production webhook URL (/webhook/...), workflow must be active
N8N_WEBHOOK_URL_MAIN=
# Leads for the screen (/proof/live). Empty = https://floaters.app.n8n.cloud/webhook/htgf-leads
N8N_LEADS_URL=
# Feedback votes -> n8n flow "42 Feedback": POST saves a vote (/api/feedback), GET on the same URL lists every vote (Candidates page). Empty = https://floaters.app.n8n.cloud/webhook/htgf-feedback
N8N_FEEDBACK_URL=
# Funnel counts and costs -> n8n flow "44 Funnel stats" (/api/funnel). Empty = https://floaters.app.n8n.cloud/webhook/htgf-funnel
N8N_FUNNEL_URL=
# Flow "46 Screen extras" (Labs top 10 + latest blind backtest) for /api/extras, /proof/labs, /proof/methodology. Empty = https://floaters.app.n8n.cloud/webhook/htgf-screen-extras
N8N_EXTRAS_URL=
# Briefing audio -> n8n flow "45 Text to speech" (/api/briefing; ElevenLabs key is the n8n credential xi-api-key)
N8N_TTS_URL=https://floaters.app.n8n.cloud/webhook/htgf-tts

# true = skip external APIs and use mocks from /data (demo safety net)
USE_MOCKS=false

# --- HTGF sourcing engine (engine/, see engine/.env.example for details) ---
GITHUB_TOKEN=
CERTSTREAM_URL=
ENRICH_LIMIT=
SINCE_DAYS=
INCUBATOR_URLS=

# Outreach sender for /api/outreach drafts (name and title in the signature)
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_TITLE=
