{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "floaters-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "floaters-dev-system-node",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "PATH=/usr/local/bin:/opt/homebrew/bin:$PATH exec node node_modules/next/dist/bin/next dev -p 4000"
      ],
      "port": 4000
    },
    {
      "name": "engine",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "engine/src/server.js"
      ],
      "port": 8787
    }
  ]
}