  "dynamicRoutes": [
    {
      "page": "/proof/company/[key]",
      "regex": "^/proof/company/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkey": "nxtPkey"
      },
      "namedRegex": "^/proof/company/(?<nxtPkey>[^/]+?)(?:/)?$"
    },
    {
      "page": "/proof/saved/[id]",
      "regex": "^/proof/saved/([^/]+?)(?:/)?$",
