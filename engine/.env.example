# Copy to engine/.env (or put the same keys in the repo-root .env.local, which the engine also reads).
# Everything is optional: without keys the engine runs on keyword fallbacks.

# LLM: Anthropic is used if set, else OpenAI, else keyword fallback
ANTHROPIC_API_KEY=
# default claude-sonnet-5-5
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# default gpt-5-mini
OPENAI_MODEL=

# Audio briefing (ElevenLabs). Voice defaults to the premade "George" voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# GitHub: without a token the source runs in reduced mode (10 searches/min, 60 calls/h)
GITHUB_TOKEN=

# Certificate Transparency stream. Public one is often down; self-host:
#   docker run -d -p 8080:8080 0rickyy0/certstream-server-go
#   CERTSTREAM_URL=ws://localhost:8080/full-stream
CERTSTREAM_URL=

# API port (dashboard at http://localhost:8787)
PORT=8787
# Leads enriched per run (web, Impressum, crt.sh, RDAP, news)
ENRICH_LIMIT=25
# GitHub search window: created within the last N days
SINCE_DAYS=120
# Comma-separated incubator / start-up listing pages (default: TUM pages, see config.js)
INCUBATOR_URLS=
# 1 = never call an LLM
NO_LLM=
